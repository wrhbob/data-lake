# ── 敏感配置（含真实密钥/口令，切勿提交）──────────────────────────
.env
*.env.local
file_asset_service/.env
# 本地 IDE / 助手配置（可能含明文命令与口令）
.claude/settings.local.json

# ── Python 虚拟环境 / 缓存 ──────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 运行时数据库 / 日志 / 临时产物 ──────────────────────────────
*.db
*.sqlite
*.sqlite3
*.log
_tmp_*.py
cq_live.txt
cq_out.txt

# ── 大体积二进制 / 生成物（另行归档到 NAS/MinIO）───────────────
# 定额 PDF 原书
quota/**/*.pdf
# 解析 manifest 生成物
manifests/
# 解析脚本测试输出（tests/out/ 里的旧产物仍在跟踪中，历史快照保留；
# 后续用 `git rm --cached -r quota/parser/tests/out/` 单开一个清理 commit）
quota/parser/tests/out/

# ── OS / IDE ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
_runtime/
logs/

# ── 解析脚本测试产物（数据/PDF/OCR 跑批结果，磁盘保留不入库）──
quota/parser/tests/

# ── 信息价解析脚本（已内迁到 info_price_pipeline/）────────────
# 脚本 + 配置入库；运行时产物（OCR 缓存 / xlsx / 日志）不入库
info_price_pipeline/**/2_输入/
info_price_pipeline/**/3_中间产物/
info_price_pipeline/**/4_输出/
info_price_pipeline/**/5_日志/

# ── 信息价分析工具（独立项目，2026-08-19 合并入仓）────────────
# 脚本 + 词典 + 坐标 + 文档入库；输入/中间产物/报告/日志不入库
info_price_analysis/1_输入/
info_price_analysis/3_中间产物/
info_price_analysis/4_输出/
info_price_analysis/5_日志/

# ── 本地调试 / 比对临时产物（一次性 diff dump / 进程快照 / 备份）──
*_diff.txt
*.bak.*
MERGE_DIFF_REPORT.md
_ppid.txt
_proc_tree.json
_resp_list.json

# ── quota-compare 跨省对比工具 ───────────────────────────
# 输入：原始样本（按需人工放置，6.5MB 数据，不入库）
quota-compare/原始样本/
# Excel 打开时自动生成的临时锁文件
quota-compare/~$*.xlsx
