# Copy to .env and fill real NAS credentials.

# PostgreSQL catalog on NAS.
FILE_ASSET_DATABASE_URL=postgresql+psycopg://file_asset:<password>@djtsoft.x3322.net:5433/file_asset

# MinIO on NAS.
FILE_ASSET_S3_ENDPOINT_URL=http://djtsoft.x3322.net:9000
FILE_ASSET_S3_ACCESS_KEY_ID=<access-key>
FILE_ASSET_S3_SECRET_ACCESS_KEY=<secret-key>
FILE_ASSET_S3_REGION_NAME=us-east-1

# Buckets.
FILE_ASSET_RAW_BUCKET=cost-raw
FILE_ASSET_EXTRACT_BUCKET=cost-extract
FILE_ASSET_REPORT_BUCKET=cost-report

# Optional local/NAS manifest file for crawler console status.
FILE_ASSET_PARSE_MANIFEST_PATH=../manifests/latest/parse_manifest.csv

# Optional filesystem mirror root. Leave empty if using MinIO only.
FILE_ASSET_NAS_MIRROR_ROOT=

# Crawler worker identity. Must be unique per machine.
FILE_ASSET_WORKER_ID=crawler-node-01
FILE_ASSET_WORKER_LEASE_SECONDS=14400
FILE_ASSET_WORKER_LIMIT=3

# Console bind address.
FILE_ASSET_HOST=127.0.0.1
FILE_ASSET_PORT=8010

# MinIO Client alias used by scripts/publish_manifest_minio.sh.
FILE_ASSET_MC_ALIAS=costlake
